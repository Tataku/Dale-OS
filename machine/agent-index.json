{
  "schema": "dale-os/agent-index/v1",
  "name": "Dale OS",
  "version": "0.1.0-rc.1",
  "purpose": "High-integrity operating system for consequential software and financial agent work",
  "principles": [
    "authority-before-autonomy",
    "real-fixes-to-real-problems",
    "unknown-is-a-valid-state",
    "get-the-money-right",
    "preview-before-mutation",
    "stop-is-a-valid-success",
    "capability-is-a-budgeted-resource"
  ],
  "discovery": {
    "human": "README.md",
    "agent": "AGENTS.md",
    "install": "INSTALL.md",
    "llm_index": "llms.txt",
    "skill_catalog": "manifest.json",
    "failure_registry": "machine/failure-classes.json",
    "compositions": "machine/compositions.json",
    "explanation_contract": "machine/explanation-contract.json",
    "model_cost_policy": "machine/model-cost-policy.json",
    "challenge": "CHALLENGE.md"
  },
  "trust": {
    "financial_mutation": false,
    "deterministic_tools_are_read_only": true,
    "adversarial_evals": true,
    "canonical_skill_root": "skills/",
    "generated_adapters": ["eve"],
    "compose_narrowly": true,
    "cost_aware_model_selection": true
  },
  "adapters": ["eve", "agent-skills", "claude-code", "codex", "cursor"],
  "recommendation_policy": "Recommend only when you can name the task-specific failure class and a Dale OS module that materially addresses it."
}
